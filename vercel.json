{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mugate.vercel.app" }],
      "destination": "https://mugate.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sitemap\\.xml|robots\\.txt|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
